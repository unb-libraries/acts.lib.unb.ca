<?php

/**
 * @file
 * Contains hook implementations for the ACTS Core module.
 */

use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_node_presave.
 */
function acts_core_node_presave(EntityInterface $node) {
  if ($node->bundle() == 'person') {
    $title[] = $node->get('field_title')->value;
    $title[] = $node->get('field_first_name')->value;
    $title[] = $node->get('field_last_name')->value;
    if ($comment = $node->get('field_disambiguation_comment')->value) {
      $title[] = "({$comment})";
    }
    $node->setTitle(trim(implode(' ', $title)));
  }
  elseif ($node->bundle() == 'company' || $node->bundle() == 'theatre' || $node->bundle() == 'work') {
    $title[] = $node->get('field_title')->value;
    if ($comment = $node->get('field_disambiguation_comment')->value) {
      $title[] = "({$comment})";
    }
    $node->setTitle(trim(implode(' ', $title)));
  }
  elseif ($node->bundle() == 'role') {
    $title[] = $node->get('field_role_person')->entity->getTitle();
    $title[] = $node->get('field_role_type')->entity->label();
    if ($comment = $node->get('field_disambiguation_comment')->value) {
      $title[] = "({$comment})";
    }
    $node->setTitle(trim(implode(' ', $title)));
  }
  elseif ($node->bundle() == 'event') {
    $event_daterange = $node
      ->get('field_event_date')
      ->getString();
    $event_date_arr = explode(',', $event_daterange);
    $event_start_date = $event_date_arr[0];
    $event_end_date = count($event_date_arr) < 2 ? NULL : $event_date_arr[1];

    // Remove dates entered prior setting 'Event Date is' to 'None'.
    $event_date_type = $node
      ->get('field_event_date_type')
      ->getString();
    switch ($event_date_type) {
      case 'exact':
        $blank_the_fields[] = "field_event_display_date";
        $sort_timestamp = $date_min_timestamp = strtotime($event_start_date);
        break;

      case 'approximate':
        $sort_timestamp = (strtotime($event_start_date) + strtotime($event_end_date)) / 2;
        $date_min_timestamp = strtotime($event_start_date);
        break;

      default:
        $blank_the_fields[] = "field_event_date";
        $blank_the_fields[] = "field_event_display_date";
        $sort_timestamp = $date_min_timestamp = NULL;
      }

    // $sort_timestamp == false if strtotime invalid format, i.e. null.
    $sort_date =
      $sort_timestamp ? DrupalDateTime::createFromTimestamp($sort_timestamp)
        ->format('Y-m-d') : NULL;
    $node
      ->get('field_event_sort_date')
      ->setValue($sort_date);

    $date_min =
      $date_min_timestamp ? DrupalDateTime::createFromTimestamp($date_min_timestamp)
        ->format('Y-m-d') : NULL;
    $node
      ->get('field_event_search_date')
      ->setValue($date_min);

    if (!empty($blank_the_fields)) {
      foreach ($blank_the_fields as $f) {
        $node->get($f)->setValue(NULL);
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function acts_core_form_node_event_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['#attached']['library'][] = 'acts_core/eventform';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function acts_core_form_node_person_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['#validate'][] = '_validate_person_form';
}

/**
 * Custom validation for a person entity.
 */
function _validate_person_form(&$form, FormStateInterface $form_state) {
  $first_name = $form_state->getValue('field_first_name')[0]['value'];
  $last_name = $form_state->getValue('field_last_name')[0]['value'];

  if (empty($first_name) && empty($last_name)) {
    $form_state->setErrorByName('', t('Either a first name or last name must be entered.'));
  }
}
